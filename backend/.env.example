NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/ai_hr_copilot
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

MAX_DOCUMENT_SIZE_MB=10
DOCUMENT_STORAGE_PATH=./storage/documents
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=128
VECTOR_SEARCH_MODE=local
VECTOR_SEARCH_TOP_K=5
RAG_TOP_K=5
RAG_MIN_SCORE=0.05
ATLAS_VECTOR_INDEX_NAME=document_chunk_vector_index

# mock | groq (free Llama) | openai (paid)
LLM_PROVIDER=mock
# Groq free default (tool-calling). Alternatives: openai/gpt-oss-120b, qwen/qwen3.8-27b
LLM_MODEL=openai/gpt-oss-20b
# Free key from https://console.groq.com/keys (or use GROQ_API_KEY)
LLM_API_KEY=
# GROQ_API_KEY=
COPILOT_MAX_MESSAGE_LENGTH=4000
AGENT_MAX_TOOL_CALLS=5
